{
  "name": "aperture-core",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nuxt build",
    "db:migrate": "node ./scripts/run-migrations.mjs",
    "db:migrate:down": "node ./scripts/run-migrations.mjs down",
    "dev": "nuxt dev --dotenv .env.development",
    "generate": "nuxt generate",
    "lint": "pnpm exec nuxt prepare && pnpm exec eslint --config ./eslint.config.mjs . --max-warnings=0",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "quality": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm exec nuxi typecheck"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@intlify/shared": "11.4.14",
    "@intlify/vue-i18n-extensions": "9.0.0",
    "@lezer/highlight": "^1.2.5",
    "@mlc-ai/web-llm": "^0.2.88",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/icon": "2.2.1",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "0.11.3",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/nuxt": "14.2.1",
    "echarts": "^6.1.0",
    "gridstack": "^12.6.0",
    "kysely": "^0.28.19",
    "mssql": "^12.7.14",
    "mysql2": "^3.24.6",
    "nuxt": "^4.6.4",
    "nuxt-icon": "1.0.0-beta.7",
    "nuxt-oidc-auth": "1.0.0-beta.10",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "undici": "^7.30.2",
    "uuid": "^13.0.2",
    "vue": "^3.5.45",
    "vue-echarts": "^8.3.2"
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@oxc-minify/binding-linux-arm64-gnu": "^0.154.0",
    "@rolldown/binding-linux-arm64-gnu": "^1.3.1",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@vitest/coverage-v8": "^4.1.12",
    "kysely-codegen": "^0.20.0",
    "tailwindcss": "^4.3.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
